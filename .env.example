# ============================================================
# REQUIRED — app will not start without these
# ============================================================

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron (any random secret string)
CRON_SECRET=

# ============================================================
# OPTIONAL — only needed when working on that feature
# ============================================================

# Cloudinary — image uploads (https://console.cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage bucket name
SUPABASE_STORAGE_BUCKET=property-photos

# Opn Payments / Omise — Thai payments (https://dashboard.omise.co)
OPN_SECRET_KEY=
OPN_PUBLIC_KEY=
OPN_WEBHOOK_SECRET=

# Stripe — international payments (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=

# Cloudflare Turnstile — bot protection (https://dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Channex — OTA channel manager (https://channex.io)
CHANNEX_API_KEY=
